# ====================================================
# CONFIGURACIÓN DE BASE DE DATOS POSTGRESQL (2date_db)
# ====================================================

# Opción A: Cadena de conexión única (Ideal para Coolify / Supabase / Neon / Render)
DATABASE_URL=postgresql://usuario:password@host_o_ip:5432/2date_db

# Opción B: Variables individuales (Despliegue estándar o Docker)
SQL_HOST=127.0.0.1
SQL_PORT=5432
SQL_DB_NAME=2date_db
SQL_USER=postgres
SQL_PASSWORD=tu_password_seguro

# ====================================================
# PUERTO Y ENTORNO DE LA APLICACIÓN
# ====================================================
PORT=3000
NODE_ENV=production

